{
  "name": "beredskapsnavet",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 4010",
    "build": "next build",
    "start": "next start -p 4010",
    "demo": "node scripts/demo.mjs",
    "db:reset": "node --experimental-sqlite scripts/seed.mjs",
    "typecheck": "tsc --noEmit",
