    "tillganglighet": "node scripts/tillganglighet.mjs"
  },
  "dependencies": {
    "next": "15.5.4",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@types/node": "22.15.3",
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6",
    "@tailwindcss/postcss": "4.1.11",
    "tailwindcss": "4.1.11",
    "typescript": "5.8.3"
  },
  "engines": {
    "node": ">=22 <23"
  }
}
